{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm build)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:studio)",
      "Bash(pnpm db:up)",
      "Bash(docker compose up *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout *)"
    ],
    "ask": [
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:migrate *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(drizzle-kit drop*)",
      "Bash(drizzle-kit push*)",
      "Bash(pnpm drizzle-kit drop*)",
      "Bash(pnpm drizzle-kit push*)",
      "Bash(pnpm exec drizzle-kit drop*)",
      "Bash(pnpm exec drizzle-kit push*)",
      "Bash(npx drizzle-kit drop*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(psql *DROP *)",
      "Bash(psql *drop *)",
      "Bash(psql *TRUNCATE *)",
      "Bash(psql *truncate *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-write.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
